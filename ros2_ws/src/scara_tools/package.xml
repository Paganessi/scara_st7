<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scara_tools</name>
  <version>0.1.0</version>
  <description>Herramientas de puesta en marcha: repetibilidad del homing, escalon PID, zona muerta.</description>
  <maintainer email="amavaga@gmail.com">Matteo (Grupo 6-F)</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>scara_bridge</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>scara_fw_sim</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
