<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scara_bringup</name>
  <version>0.1.0</version>
  <description>Launch unico y parametros (scara.yaml) del SCARA Estacion 7.</description>
  <maintainer email="amavaga@gmail.com">Matteo (Grupo 6-F)</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>scara_bridge</exec_depend>
  <exec_depend>scara_homing</exec_depend>
  <exec_depend>scara_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- micro_ros_agent se compila en ~/uros_ws (workspace aparte) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
